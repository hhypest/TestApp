<Project>

  <!--
    Единый источник версии для всех проектов решения (issue #17).

    До этого версии не было нигде: сборки получали неявный 1.0.0, поэтому по
    развёрнутому образу нельзя было сказать, что именно в нём. VersionPrefix
    здесь — та версия, которую несёт ветка; суффикс предрелиза передаёт CI:

        dotnet publish -p:VersionSuffix=rc.1   ->   1.0.0-rc.1

    Политика тегов и порядок выпуска — docs/OPERATIONS.md §16.2.
  -->
  <PropertyGroup>
    <VersionPrefix>1.0.0</VersionPrefix>
  </PropertyGroup>

</Project>
