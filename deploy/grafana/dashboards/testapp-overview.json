{
  "title": "TestApp Overview",
  "uid": "testapp-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "utc",
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "30s",
  "tags": ["testapp"],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request rate by status class",
      "description": "docs/SLO_ALERTS.md §6: request rate by HTTP status class.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "sum by (status_class) (label_replace(rate(http_server_request_duration_seconds_count{http_route!~\"/health.*\"}[$__rate_interval]), \"status_class\", \"${1}xx\", \"http_response_status_code\", \"(.)..\"))",
          "legendFormat": "{{status_class}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Request duration p50/p95/p99",
      "description": "docs/SLO_ALERTS.md §6: p50/p95/p99 request duration. Excludes /health/*.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health.*\"}[$__rate_interval])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health.*\"}[$__rate_interval])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route!~\"/health.*\"}[$__rate_interval])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Metrics pipeline up",
      "description": "Prometheus scrape health of the OTel Collector target. NOT the same signal as /health/ready — a dedicated readiness probe (e.g. blackbox_exporter) is still open, see docs/SLO_ALERTS.md.",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ]
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "up{job=\"testapp\"}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Exception rate by kind",
      "description": "docs/SLO_ALERTS.md §6: unhandled/concurrency/idempotency exception rate.",
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 9 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "sum by (kind) (rate(testapp_api_exception_total[$__rate_interval]))",
          "legendFormat": "{{kind}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "row",
      "title": "Outbox",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Outbox pending count",
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "testapp_outbox_pending",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Oldest pending Outbox message age",
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "testapp_outbox_oldest_pending_age_seconds",
          "legendFormat": "oldest pending age"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Outbox publish outcomes",
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 18 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "sum by (outcome) (rate(testapp_outbox_publish_total[$__rate_interval]))",
          "legendFormat": "{{outcome}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Active dead-letter count",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "testapp_outbox_dead_letters",
          "legendFormat": "dead letters"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Explicit dead-letter actions",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 25 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "sum by (action) (rate(testapp_outbox_dead_letter_action_total[$__rate_interval]))",
          "legendFormat": "{{action}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "row",
      "title": "Attempts",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Overdue in-progress attempt count",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "testapp_attempt_overdue",
          "legendFormat": "overdue"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Oldest overdue attempt lag",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "testapp_attempt_oldest_overdue_lag_seconds",
          "legendFormat": "oldest overdue lag"
        }
      ]
    },
    {
      "id": 30,
      "type": "row",
      "title": "Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 40 }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Process CPU time by mode",
      "description": "dotnet.process.cpu.time (OpenTelemetry.Instrumentation.Runtime 1.17.0). Rate of a seconds-counter: ~1.0 means fully saturating one core.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "sum by (cpu_mode) (rate(dotnet_process_cpu_time_seconds_total[$__rate_interval]))",
          "legendFormat": "{{cpu_mode}}"
        }
      ]
    },
    {
      "id": 32,
      "type": "timeseries",
      "title": "Process working set memory",
      "description": "dotnet.process.memory.working_set.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "dotnet_process_memory_working_set_bytes",
          "legendFormat": "working set"
        }
      ]
    },
    {
      "id": 33,
      "type": "timeseries",
      "title": "GC collections by generation",
      "description": "dotnet.gc.collections.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "sum by (gc_heap_generation) (rate(dotnet_gc_collections_total[$__rate_interval]))",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ]
    },
    {
      "id": 34,
      "type": "timeseries",
      "title": "Heap size at last collection by generation",
      "description": "dotnet.gc.last_collection.heap.size. Updates only when a GC occurs, not continuously.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 48 },
      "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "testapp-prometheus" },
          "expr": "dotnet_gc_last_collection_heap_size_bytes",
          "legendFormat": "{{gc_heap_generation}}"
        }
      ]
    }
  ]
}
