{
  "realm": "testapp-staging",
  "displayName": "TestApp Staging",
  "enabled": true,
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "sslRequired": "all",
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "test-author",
        "description": "Can author and review tests"
      },
      {
        "name": "test-admin",
        "description": "Can administer assignments and operations"
      }
    ]
  },
  "groups": [
    {
      "name": "students"
    }
  ],
  "clients": [
    {
      "clientId": "testapp-api",
      "name": "TestApp API",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "$(env:TESTAPP_KEYCLOAK_CLIENT_SECRET)",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://$(env:TESTAPP_PUBLIC_HOST)/*"
      ],
      "webOrigins": [
        "https://$(env:TESTAPP_PUBLIC_HOST)"
      ],
      "attributes": {
        "post.logout.redirect.uris": "https://$(env:TESTAPP_PUBLIC_HOST)/*"
      },
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "roles",
            "jsonType.label": "String"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "consentRequired": false,
          "config": {
            "full.path": "false",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "true",
            "claim.name": "groups"
          }
        },
        {
          "name": "testapp audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "testapp-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": []
}
