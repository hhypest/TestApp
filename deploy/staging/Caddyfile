# Ingress staging-контура (issue #16).
#
# Единственная точка, опубликованная наружу. Терминирует TLS (сертификаты Let's Encrypt
# получаются автоматически по имени из TESTAPP_PUBLIC_HOST) и проксирует три вещи:
# API, Keycloak и Grafana.
#
# Caddy сам выставляет X-Forwarded-For/Proto/Host. Чтобы приложение им доверяло, в
# compose.staging.yaml объявлена доверенная сеть ReverseProxy__KnownNetworks — без неё
# заголовки будут отброшены, и лимит частоты увидит один адрес вместо клиентских.

{$TESTAPP_PUBLIC_HOST} {
	encode zstd gzip

	# Keycloak под /auth: путь совпадает с KC_HOSTNAME, иначе issuer в токене
	# не сойдётся с Keycloak__Authority и валидация JWT будет падать.
	handle_path /auth/* {
		reverse_proxy keycloak:8080
	}

	handle_path /grafana/* {
		reverse_proxy grafana:3000
	}

	# Health наружу нужен для активной пробы из #19: blackbox_exporter обязан ходить
	# по внешнему URL через этот же ingress. Проба по имени контейнера проверила бы
	# внутреннюю сеть и не заметила отказа, который видит настоящий клиент.
	handle {
		reverse_proxy api:8080
	}
}
